{
  "name": "orbullets",
  "private": true,
  "version": "2.6.0",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run api:local\" \"vite\"",
    "dev:electron": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "api:local": "node backend/run-local.js",
    "build": "vite build --mode electron",
    "build:electron": "vite build --mode electron && electron-builder",
    "start": "electron ."
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.101.1",
    "sql.js": "^1.13.0",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "electron": "^41.1.1",
    "electron-builder": "^26.8.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "vite": "^8.0.1",
    "wait-on": "^9.0.4"
  },
  "build": {
    "appId": "com.orbullets.desktop",
    "productName": "OrBullets",
    "icon": "build/icon.ico",
    "afterPack": "electron/afterPack.js",
    "directories": {
      "output": "C:/Users/franc/projetos/OrBullets-setup"
    },
    "asar": true,
    "asarUnpack": [
      "**/node_modules/sql.js/dist/**"
    ],
    "files": [
      "**/*",
      "!src/**",
      "!supabase/**",
      "!release/**",
      "!release-build/**",
      "!installer-out/**",
      "!.cursor/**",
      "!.git/**"
    ],
    "extraResources": [
      {
        "from": ".env",
        "to": ".env"
      }
    ],
    "extraFiles": [
      {
        "from": "build/icon.ico",
        "to": "OrBullets.ico"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis"
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "OrBullets"
    }
  }
}
